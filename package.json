{
  "name": "zapmenu-back",
  "version": "1.0.0",
  "description": "backend do menu via whatsapp",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "loja-demo": "tsx --env-file-if-exists=.env scripts/loja-demo.ts",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanlucena/zapmenu-back.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nathanlucena/zapmenu-back/issues"
  },
  "homepage": "https://github.com/nathanlucena/zapmenu-back#readme",
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.6.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "baileys": "7.0.0-rc14",
    "fastify": "^5.11.2",
    "openai": "^7.34.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "0.12.0",
    "zod": "^4.4.3"
  }
}
