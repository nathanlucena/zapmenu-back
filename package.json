  "bugs": {
    "url": "https://github.com/nathanlucena/zapmenu-back/issues"
  },
  "homepage": "https://github.com/nathanlucena/zapmenu-back#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^6.19.3",
    "@wppconnect-team/wppconnect": "^2.2.6",
    "fastify": "^5.11.2",
    "openai": "^7.34.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
