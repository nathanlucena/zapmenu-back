PORT=3000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://user:pass@localhost:5432/zapmenu

WPP_MENU_SESSION_NAME=zapmenu-gestao
WPP_MENU_PHONE_NUMBER=5511900000001
WPP_MENU_TOKEN_STORE_PATH=./tokens/menu

WPP_ORDERS_SESSION_NAME=zapmenu-pedidos
# Mesmo número da gestão = uma sessão só; mensagens com PED-XXXX vão para pedidos, as outras para a gestão
WPP_ORDERS_PHONE_NUMBER=5511900000002
WPP_ORDERS_TOKEN_STORE_PATH=./tokens/orders

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=https://api.zapmenu.com/v1/webhooks/mercado-pago
# Só com credenciais de teste; APRO faz o PIX de teste ser aprovado. Vazia = desligada
MERCADO_PAGO_PAGADOR_TESTE=

# Assinatura do ZapMenu pelas lojas (Mercado Pago Assinaturas), na conta do PRÓPRIO ZapMenu:
# credenciais separadas das de cima. Use só credenciais de teste (usuário de teste do Mercado Pago).
# Sem token, "assinar" fica indisponível; o teste de 14 dias e os limites dos planos valem do mesmo jeito.
MERCADO_PAGO_ASSINATURAS_ACCESS_TOKEN=
# Assinatura secreta do webhook dessa aplicação (obrigatória com o token). URL do webhook no painel:
# https://api.zapmenu.com/v1/webhooks/mercado-pago-assinaturas, eventos "Planos e assinaturas".
# Com o ngrok: https://<dominio>/api/webhooks/mercado-pago-assinaturas (o front repassa).
MERCADO_PAGO_ASSINATURAS_WEBHOOK_SECRET=
# true (padrão) manda o link do sandbox. Só desligue com credenciais de produção.
MERCADO_PAGO_ASSINATURAS_SANDBOX=true
# Para onde o Mercado Pago leva a loja depois de cadastrar o cartão. Vazio: FRONTEND_URL_PUBLICA.
ASSINATURA_URL_RETORNO=
# De quanto em quanto tempo o job das assinaturas roda (cada aviso sai uma vez por dia).
ASSINATURAS_VERIFICACAO_INTERVALO_MINUTOS=60

# Transcrição de áudios (plano Profissional) por uma API compatível com a da OpenAI (/audio/transcriptions).
# OpenAI: URL https://api.openai.com/v1 e modelo whisper-1. Groq: https://api.groq.com/openai/v1 e whisper-large-v3.
# Sem chave, o recurso fica desligado e o bot pede para escrever. O áudio nunca é guardado.
TRANSCRICAO_API_URL=https://api.openai.com/v1
TRANSCRICAO_API_KEY=
TRANSCRICAO_MODELO=whisper-1

# Melhor Envio (envio por transportadora, plano Profissional, tipo Loja). Crie o app no painel do
# Melhor Envio (sandbox: https://sandbox.melhorenvio.com.br) e cadastre a URL de retorno abaixo.
# Sem client id/secret, o envio por transportadora fica desligado. Use só o sandbox por enquanto.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_SANDBOX=true
# Vazio: FRONTEND_URL_PUBLICA/api/melhor-envio/retorno (o front repassa para /v1/melhor-envio/retorno)
MELHOR_ENVIO_URL_RETORNO=
MELHOR_ENVIO_EMAIL_CONTATO=contato@zapmenu.com.br

PEDIDO_TTL_MINUTOS=20
# Minutos que a loja tem para aceitar ou recusar o pedido depois que o cliente manda o código
PEDIDO_ACEITE_MINUTOS=15
# Horas depois da criação em que um pedido pago/a caminho é concluído sozinho
PEDIDO_CONCLUSAO_HORAS=12
PAGAMENTO_POLLING_INTERVALO_SEGUNDOS=60
# Só com WPP_MODO_AUTOTESTE=true: o PIX é dado como pago N segundos depois de gerado (simula o cliente pagando). 0 desliga
PAGAMENTO_SIMULADO_SEGUNDOS=30

FRONTEND_ALLOWED_ORIGIN=http://localhost:3001
# Endereço público do app para os links mandados no WhatsApp (ex.: https://meu-zapmenu.ngrok-free.app).
# Vazio: usa FRONTEND_ALLOWED_ORIGIN. Com o ngrok, aponte também o MERCADO_PAGO_NOTIFICATION_URL para
# https://<dominio>/api/webhooks/mercado-pago (o front repassa para a API).
FRONTEND_URL_PUBLICA=
# Como o backend alcança o front para gerar a imagem da prévia das alterações. Vazio: FRONTEND_ALLOWED_ORIGIN.
FRONTEND_URL_INTERNA=

# Sessões WhatsApp que sobem no boot: "menu", "orders" ou "menu,orders"
WPP_SESSOES=menu,orders
# Modo de teste manual: o bot só atende o chat "você mesmo" da conta conectada e os números
# de WPP_NUMEROS_PERMITIDOS (separados por vírgula); envios a qualquer outro número são bloqueados
WPP_MODO_AUTOTESTE=false
WPP_NUMEROS_PERMITIDOS=
# Log interno do Baileys (silent|error|warn|info|debug|trace). "trace" mostra cada pacote trocado com o WhatsApp
WPP_LOG_LEVEL=warn

# Telefones (com DDI e DDD, separados por vírgula) que podem usar o número de gestão.
# Vazio = qualquer número pode cadastrar cardápio (o boot avisa).
GESTAO_TELEFONES_PERMITIDOS=

# IA que interpreta as mensagens de gestão (API compatível com OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Geocoding: converte o endereço da loja em coordenada para a entrega por distância.
# Restrinja a chave à Geocoding API e ao IP do servidor. Sem chave, o cadastro de endereço fica indisponível.
GOOGLE_MAPS_API_KEY=
# Consultas por dia ao Google antes de recusar (respostas repetidas saem do cache). 0 = sem limite.
# Mantenha abaixo da cota diária configurada no Console do Google.
GOOGLE_GEOCODING_LIMITE_DIARIO=300


