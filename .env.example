PORT=3000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://user:pass@localhost:5432/zapmenu

WPP_MENU_SESSION_NAME=zapmenu-gestao
WPP_MENU_PHONE_NUMBER=5511900000001
WPP_MENU_TOKEN_STORE_PATH=./tokens/menu

WPP_ORDERS_SESSION_NAME=zapmenu-pedidos
WPP_ORDERS_PHONE_NUMBER=5511900000002
WPP_ORDERS_TOKEN_STORE_PATH=./tokens/orders

WPP_HEADLESS=true
WPP_CHROMIUM_EXECUTABLE_PATH=

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=https://api.zapmenu.com/v1/webhooks/mercado-pago

PEDIDO_TTL_MINUTOS=20
PAGAMENTO_POLLING_INTERVALO_SEGUNDOS=60

FRONTEND_ALLOWED_ORIGIN=http://localhost:3001

# Sessões WhatsApp que sobem no boot: "menu", "orders" ou "menu,orders"
WPP_SESSOES=menu,orders
# Modo de teste manual: o bot só atende o chat "você mesmo" da conta conectada e os números
# de WPP_NUMEROS_PERMITIDOS (separados por vírgula); envios a qualquer outro número são bloqueados
WPP_MODO_AUTOTESTE=false
WPP_NUMEROS_PERMITIDOS=
# Log interno do WPPConnect (error|warn|info|debug|silly). "silly" mostra cada evento interno
WPP_LOG_LEVEL=warn

# Telefones (com DDI e DDD, separados por vírgula) que podem usar o número de gestão.
# Vazio = qualquer número pode cadastrar cardápio (o boot avisa).
GESTAO_TELEFONES_PERMITIDOS=

# IA que interpreta as mensagens de gestão (API compatível com OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Geocoding: converte o endereço da loja em coordenada para a entrega por distância.
# Restrinja a chave à Geocoding API e ao IP do servidor. Sem chave, o cadastro de endereço fica indisponível.
GOOGLE_MAPS_API_KEY=


